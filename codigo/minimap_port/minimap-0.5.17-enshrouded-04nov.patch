+    void ScanCameraRoot(uintptr_t root, PlayerPositionCandidate& best)
+    {
+        ScanCameraRootWithLimits(
+            root,
+            best,
+            21,
+            22,
+            PLAYER_CAMERA_ROOT_SCAN_BYTES,
+            PLAYER_CAMERA_POINTER_SCAN_BYTES,
+            PLAYER_CAMERA_CHILD_SCAN_BYTES);
+    }
