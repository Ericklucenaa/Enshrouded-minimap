+    bool SafeRead(uintptr_t address, void* buffer, std::size_t size)
+    {
+        __try
+        {
+            std::memcpy(buffer, reinterpret_cast<const void*>(address), size);
+            return true;
+        }
+        __except (EXCEPTION_EXECUTE_HANDLER)
+        {
+            return false;
+        }
+    }
