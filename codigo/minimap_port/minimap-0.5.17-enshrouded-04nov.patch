+            placement == MinimapPlacement::MiddleLeft ||
+            placement == MinimapPlacement::BottomLeft;
+    }
+
+    int ParseMinimapToggleKey(const std::string& value, int fallback = VK_F10)
+    {
+        const std::string normalized = NormalizeConfigValue(value);
+        if (normalized == "none" || normalized == "disabled" || normalized == "0") return 0;
+        if (normalized.size() > 2 && normalized.substr(0, 2) == "0x") {
+            unsigned code = 0;
+            for (std::size_t i = 2; i < normalized.size(); ++i) {
+                const char c = normalized[i];
+                const int digit = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1;
+                if (digit < 0 || code > 15) return fallback;
+                code = code * 16 + digit;
+            }
+            return code <= 254 ? static_cast<int>(code) : fallback;
+        }
+        if (normalized.size() == 1 && normalized[0] >= 'a' && normalized[0] <= 'z') return normalized[0] - 'a' + 'A';
+        if (normalized == "add" || normalized == "numpadplus") return VK_ADD;
+        if (normalized == "subtract" || normalized == "numpadminus") return VK_SUBTRACT;
+        if (normalized == "oemplus" || normalized == "plus") return VK_OEM_PLUS;
+        if (normalized == "oemminus" || normalized == "minus") return VK_OEM_MINUS;
+        if (normalized.size() >= 2 && normalized[0] == 'f')
+        {
+            int number = 0;
+            bool valid = true;
+            for (std::size_t index = 1; index < normalized.size(); ++index)
+            {
+                const char ch = normalized[index];
+                if (ch < '0' || ch > '9')
+                {
+                    valid = false;
+                    break;
+                }
+                if (number > 24) return fallback;
+                number = (number * 10) + (ch - '0');
+            }
+            if (valid && number >= 1 && number <= 24)
+                return VK_F1 + number - 1;
+        }
+
+        if ((normalized == "numpad" && value.find('*') != std::string::npos) || normalized == "numpadmultiply" || normalized == "numpadstar" ||
+            normalized == "multiply" || normalized == "asterisk" || normalized == "star")
+            return VK_MULTIPLY;
+        if (normalized == "insert" || normalized == "ins")
+            return VK_INSERT;
+        if (normalized == "delete" || normalized == "del")
+            return VK_DELETE;
+        if (normalized == "home")
+            return VK_HOME;
+        if (normalized == "end")
+            return VK_END;
+        if (normalized == "pageup" || normalized == "pgup")
+            return VK_PRIOR;
+        if (normalized == "pagedown" || normalized == "pgdn")
+            return VK_NEXT;
+        if (normalized == "backspace")
+            return VK_BACK;
+
+        return fallback;
+    }
+
+    // Only literal resize characters carry modifiers; legacy VK/F-key bindings
+    // retain their existing single-key behavior. Never pass encoded chords to Win32.
+    constexpr int kMinimapLiteralKey = 0x10000;
+
+    int EncodeMinimapLiteralKey(SHORT mapping)
+    {
+        const unsigned code = static_cast<unsigned short>(mapping);
+        const unsigned vk = code & 0xff, modifiers = code >> 8;
+        if (mapping == -1 || vk == 0 || vk > 254 || (modifiers & ~7u) != 0) return 0;
+        return kMinimapLiteralKey | static_cast<int>(code);
+    }
+
+    int ParseMinimapSizeKey(const std::string& value, int fallback, HKL layout)
+    {
+        const auto first = value.find_first_not_of(" \t\r\n");
+        const auto last = value.find_last_not_of(" \t\r\n");
+        if (first != std::string::npos && first == last && (value[first] == '{' || value[first] == '}'))
+            return EncodeMinimapLiteralKey(VkKeyScanExA(value[first], layout));
+        return ParseMinimapToggleKey(value, fallback);
+    }
+
+    bool IsMinimapSizeKeyDown(int binding, SHORT (WINAPI* poll)(int))
+    {
+        if (binding <= 0) return false;
+        const int vk = binding & 0xff;
+        if (vk == 0 || vk > 254 || (poll(vk) & 0x8000) == 0) return false;
+        if ((binding & kMinimapLiteralKey) == 0) return true;
+        const int modifiers = ((poll(VK_SHIFT) & 0x8000) ? 1 : 0) |
+            ((poll(VK_CONTROL) & 0x8000) ? 2 : 0) | ((poll(VK_MENU) & 0x8000) ? 4 : 0);
+        return modifiers == ((binding >> 8) & 7);
+    }
+
+    bool ParseConfigBoolean(const std::string& value, bool fallback)
+    {
+        const std::string normalized = NormalizeConfigValue(value);
+        if (normalized == "true" || normalized == "1" || normalized == "yes" ||
+            normalized == "on" || normalized == "enabled" || normalized == "enable")
+        {
+            return true;
+        }
+
+        if (normalized == "false" || normalized == "0" || normalized == "no" ||
+            normalized == "off" || normalized == "disabled" || normalized == "disable")
+        {
+            return false;
+        }
+
+        return fallback;
+    }
+
+    int ParseConfigInteger(const std::string& value, int fallback, int low, int high)
+    {
+        const auto first = value.find_first_not_of(" \t\r\n");
+        if (first == std::string::npos)
+            return fallback;
+        const auto last = value.find_last_not_of(" \t\r\n");
+
+        int parsed = 0;
+        for (std::size_t i = first; i <= last; ++i)
+        {
+            const char ch = value[i];
+            if (ch < '0' || ch > '9')
+                return fallback;
+            // Keep validating the whole value after saturation. Do not turn
+            // "-1" into 1 or "1.5" into 15 by stripping punctuation.
+            parsed = static_cast<int>(MinValue<std::int64_t>(high, static_cast<std::int64_t>(parsed) * 10 + (ch - '0')));
+        }
+
+        return ClampValue(parsed, low, high);
+    }
+
+    int ParseSignedConfigInteger(const std::string& value, int fallback, int low, int high)
+    {
+        const auto first = value.find_first_not_of(" \t\r\n");
+        if (first == std::string::npos) return fallback;
+        const auto last = value.find_last_not_of(" \t\r\n");
+        std::size_t index = first;
+        bool negative = false;
+        if (value[index] == '+' || value[index] == '-')
+        {
+            negative = value[index] == '-';
+            if (++index > last) return fallback;
+        }
+        const std::uint64_t limit = negative ?
+            static_cast<std::uint64_t>(-(static_cast<std::int64_t>(low))) :
+            static_cast<std::uint64_t>(high);
+        std::uint64_t parsed = 0;
+        for (; index <= last; ++index)
+        {
+            const char ch = value[index];
+            if (ch < '0' || ch > '9') return fallback;
+            const auto digit = static_cast<std::uint64_t>(ch - '0');
+            parsed = parsed > (limit - MinValue(limit, digit)) / 10 ?
+                limit : MinValue(limit, parsed * 10 + digit);
+        }
+        const std::int64_t signedValue = negative ?
+            -static_cast<std::int64_t>(parsed) : static_cast<std::int64_t>(parsed);
+        return ClampValue(static_cast<int>(signedValue), low, high);
+    }
+
+    std::string BoundedOffsetRawForLog(const std::string& value)
+    {
+        const auto first = value.find_first_not_of(" \t\r\n");
+        if (first == std::string::npos)
+            return "<invalid>";
+        const auto last = value.find_last_not_of(" \t\r\n");
+        if (last - first + 1 > 16)
+            return "<invalid>";
+
+        std::size_t index = first;
+        if (value[index] == '+' || value[index] == '-')
+            ++index;
+        if (index > last)
+            return "<invalid>";
+        for (; index <= last; ++index)
+            if (value[index] < '0' || value[index] > '9')
+                return "<invalid>";
+        return value.substr(first, last - first + 1);
+    }
+
+    std::string BoundedConfigSourceForLog(const std::string& value)
+    {
+        constexpr std::size_t kMaxSourceLength = 320;
+        std::string bounded = value.substr(0, kMaxSourceLength);
+        for (char& ch : bounded)
+            if (ch == '|' || static_cast<unsigned char>(ch) < 0x20 || ch == 0x7f)
+                ch = '?';
+        if (value.size() > kMaxSourceLength)
+            bounded += "...";
+        return bounded;
+    }
+
+    int ScaleMinimapOffset(int offsetAt1080p, std::uint32_t height)
+    {
+        const double scaled = static_cast<double>(offsetAt1080p) * height / 1080.0;
+        return static_cast<int>(ClampValue<std::int64_t>(
+            static_cast<std::int64_t>(std::llround(scaled)), INT_MIN, INT_MAX));
+    }
+
+    std::string MinimapToggleKeyName(int key)
+    {
+        if (key >= VK_F1 && key <= VK_F24)
+        {
+            std::ostringstream oss;
+            oss << "F" << (key - VK_F1 + 1);
+            return oss.str();
+        }
+
+        switch (key)
+        {
+        case VK_MULTIPLY:
+            return "Numpad *";
+        case VK_INSERT:
+            return "Insert";
+        case VK_DELETE:
+            return "Delete";
+        case VK_HOME:
+            return "Home";
+        case VK_END:
+            return "End";
+        case VK_PRIOR:
+            return "PageUp";
+        case VK_NEXT:
+            return "PageDown";
+        case VK_BACK:
+            return "Backspace";
+        default:
+            return key == 0 ? "Disabled" : "VK " + std::to_string(key);
+        }
+    }
+
+    bool ReadMarkerVisibility(ModContext* modContext, const MinimapConfigFileSnapshot& configSnapshot, const char* key)
+    {
+        std::string value = "true", source;
+        if (!TryReadMinimapConfigStringFromFile(configSnapshot, key, value, source) &&
+            modContext != nullptr && modContext->config.GetString)
+            value = modContext->config.GetString("minimap_mod", key, value);
+        return ParseConfigBoolean(value, true);
+    }
+
+    void RefreshMinimapConfig(ModContext* modContext, bool forceLog = false)
