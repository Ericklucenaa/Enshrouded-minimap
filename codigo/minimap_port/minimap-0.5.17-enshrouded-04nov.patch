+            "post_gate_fail","post_read_fail","ctx_changed","post_owner_fail","owner_mismatch","captured","screen1"};
+        o << "[Minimap] HUD diag";
+        for (int i = 0; i < 12; ++i) o << " | " << names[i] << "=" << g_hudDiag[i].exchange(0);
