+    void CaptureMenuVisibilityCallsiteHook()
+    {
+        MM_AGGREGATE_MENU_WRAPPER(wrapper);
+        g_hudDiag[0]++;
+        const auto epoch = g_menuVisibilityCaptureEpoch.load(std::memory_order_acquire);
+        MenuOwnershipSample before{};
+        std::array<uintptr_t, 4> contextBefore{};
+        std::uint8_t initialScreen = 0;
+        const bool diagRuntime = g_client10 && g_runtimeCallbacksActive.load(std::memory_order_acquire);
+        const bool diagHook = g_menuVisibilityHookActive.load(std::memory_order_acquire);
+        const bool diagOwner = diagRuntime && diagHook && SampleCurrentMenuOwnership(before, true, PublicCreativeCompat::ProofOrigin::CallbackPre);
+        const bool diagRead = diagOwner && TryReadCurrentHudScreenType(initialScreen, &contextBefore);
+        if (!diagRuntime) g_hudDiag[1]++; else if (!diagHook) g_hudDiag[2]++; else if (!diagOwner) g_hudDiag[3]++; else if (!diagRead) g_hudDiag[4]++;
+        HudDiagFlush();
+        const bool staged = diagRead;
+        const bool preservePriorGameplay = staged && initialScreen == 1 &&
+            g_menuVisibilitySnapshot.AllowsGameplay(GetTickCount64());
+        if (!preservePriorGameplay)
+            g_menuVisibilitySnapshot.Clear();
+
+        const auto original = reinterpret_cast<MenuRendererFn>(
+            g_originalMenuRenderer.load(std::memory_order_acquire));
+        if (original == nullptr)
+        {
+            g_menuVisibilitySnapshot.Clear();
+            MM_AGGREGATE_MENU_NULL_ORIGINAL(wrapper);
+            return;
+        }
+        MM_AGGREGATE_MENU_FORWARD_STARTED(wrapper);
+        original();
+        MM_AGGREGATE_MENU_FORWARD_RETURNED(wrapper);
+
+        if (!staged || epoch != g_menuVisibilityCaptureEpoch.load(std::memory_order_acquire) ||
+            !g_client10 || !g_runtimeCallbacksActive.load(std::memory_order_acquire) ||
+            !g_menuVisibilityHookActive.load(std::memory_order_acquire))
+        {
+            if (staged) g_hudDiag[5]++;
+            g_menuVisibilitySnapshot.Clear();
+            return;
+        }
+
+        std::uint8_t screen = 0;
+        std::array<uintptr_t, 4> contextAfter{};
+        MenuOwnershipSample after{};
+        {
+            const bool r = TryReadCurrentHudScreenType(screen, &contextAfter);
+            const bool same = r && contextBefore == contextAfter;
+            const bool own = same && SampleCurrentMenuOwnership(after, true, PublicCreativeCompat::ProofOrigin::CallbackPost);
+            const bool match = own && before.kind == after.kind && before.identity == after.identity;
+            if (!r) g_hudDiag[6]++; else if (!same) g_hudDiag[7]++; else if (!own) g_hudDiag[8]++; else if (!match) g_hudDiag[9]++;
+            if (r) g_hudDiagLastScreen.store(screen);
+        }
+        if (!TryReadCurrentHudScreenType(screen, &contextAfter) || contextBefore != contextAfter ||
+            !SampleCurrentMenuOwnership(after, true, PublicCreativeCompat::ProofOrigin::CallbackPost) || before.kind != after.kind ||
+            before.identity != after.identity ||
+            epoch != g_menuVisibilityCaptureEpoch.load(std::memory_order_acquire) ||
+            !g_client10 || !g_runtimeCallbacksActive.load(std::memory_order_acquire) ||
+            !g_menuVisibilityHookActive.load(std::memory_order_acquire))
+        {
+            g_menuVisibilitySnapshot.Clear();
+            return;
+        }
+
+        g_menuVisibilitySnapshot.Capture(screen, GetTickCount64(), true);
+        g_hudDiag[10]++; if (screen == 1) g_hudDiag[11]++;
+        if (epoch != g_menuVisibilityCaptureEpoch.load(std::memory_order_acquire) ||
+            !g_client10 || !g_runtimeCallbacksActive.load(std::memory_order_acquire) ||
+            !g_menuVisibilityHookActive.load(std::memory_order_acquire))
+            g_menuVisibilitySnapshot.Clear();
+    }
