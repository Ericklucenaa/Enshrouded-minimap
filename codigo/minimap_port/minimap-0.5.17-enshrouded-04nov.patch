+            modContext != nullptr && modContext->config.GetString)
+        {
+            configuredMapSampleStep = modContext->config.GetString("minimap_mod", "map_sample_step", configuredMapSampleStep);
+            mapSampleStepSource = "shroudtopia_config_api";
