+    bool ReadVulkanTableFunction(uintptr_t table, std::size_t offset, uintptr_t& outValue)
+    {
+        outValue = 0;
+        if (table == 0)
+            return false;
+        return SafeReadValue(table + VulkanSlot(offset), outValue);
+    }
