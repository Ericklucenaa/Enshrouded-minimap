+            return fresh;
+        }
+#endif
+        if (!CurrentProfileAllowsMinimapGameplay())
+            return false;
+        CURSORINFO cursorInfo{};
+        cursorInfo.cbSize = sizeof(cursorInfo);
+        if (GetCursorInfo(&cursorInfo) && (cursorInfo.flags & CURSOR_SHOWING) != 0)
+            return false;
