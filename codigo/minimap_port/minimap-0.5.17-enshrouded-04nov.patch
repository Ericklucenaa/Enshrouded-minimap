+    bool IsPlausibleWorldPosition(float x, float y, float z)
+    {
+        return std::abs(x) < 30000.0f &&
+            std::abs(z) < 30000.0f &&
+            y > -5000.0f &&
+            y < 8000.0f &&
+            (std::abs(x) > 1.0f || std::abs(z) > 1.0f);
+    }
