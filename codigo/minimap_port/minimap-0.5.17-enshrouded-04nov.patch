+            << " | player_arrow_glow_style=" << MinimapArrowGlow::StyleName(playerArrowGlowStyle)
+            << " | ping_glow=" << (pingGlow ? "on" : "off")
+            << " | ping_glow_style=" << MinimapArrowGlow::StyleName(pingGlowStyle)
